# Copie para .env e ajuste. Todas as variáveis são opcionais.
CHIPS_DATA_DIR=./data
# CHIPS_DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/chips   # padrão: SQLite em CHIPS_DATA_DIR
# CHIPS_SECRET_KEY=troque-por-um-valor-longo-e-aleatorio                         # padrão: gerado em data/.secret_key
CHIPS_ALLOW_SIGNUP=true          # false = só administradores criam contas
CHIPS_LOCK_MINUTES=20            # reserva de um chip para um anotador
CHIPS_PUBLIC_URL=http://localhost:8000

# Google Earth Engine (gratuito para ONGs/pesquisa)
# CHIPS_GEE_PROJECT=meu-projeto-cloud
# CHIPS_GEE_SERVICE_ACCOUNT=chips@meu-projeto-cloud.iam.gserviceaccount.com
# CHIPS_GEE_KEY_FILE=/secrets/gee-key.json

# Google Drive — OAuth por usuário (recomendado)
# CHIPS_DRIVE_CLIENT_SECRETS=/secrets/drive-oauth-client.json
# ...ou conta de serviço + pasta em Drive compartilhado
# CHIPS_DRIVE_SERVICE_ACCOUNT=/secrets/drive-sa.json
# CHIPS_DRIVE_FOLDER_ID=1AbCdEf...
